# =====================================================================
# 6 AI BOT TRADING DESK — EXCHANGE CREDENTIALS CONFIGURATION
# Copy this file to .env.local to configure your exchange credentials.
# =====================================================================

# Exchange selection: binance, coinbase, kraken, bybit, okx, hyperliquid
EXCHANGE_ID=binance

# API Credentials from your exchange dashboard
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=

# EXECUTION SWITCHES
# Set to 'true' for paper testnet with zero risk
USE_TESTNET=true

# Set to 'true' ONLY when you are ready to send real orders to the live order book
LIVE_TRADING_ENABLED=false

# HARD RISK GUARDRAILS
MAX_POSITION_SIZE_USD=50.0
MAX_DAILY_DRAWDOWN_PCT=3.0
